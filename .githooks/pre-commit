#!/usr/bin/env bash
# Runs format check, lint, mypy --strict and unit tests inside Docker before every commit.
# Enable with `make hooks` (sets core.hooksPath=.githooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# 1. Guard the GitHub per-file limit (snapshots are committed on purpose, but must stay < 50 MB).
limit=$((45 * 1024 * 1024))
while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  size=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f")
  if [ "$size" -gt "$limit" ]; then
    echo "pre-commit: $f is $((size / 1024 / 1024)) MB (> 45 MB). Split the snapshot or use LFS." >&2
    exit 1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACM)

# 2. Only run the toolchain when Python/config files are staged.
if git diff --cached --name-only --diff-filter=ACM | grep -Eq '\.(py|toml|yaml|yml)$|^Makefile$|^Dockerfile$'; then
  if ! docker info >/dev/null 2>&1; then
    echo "pre-commit: Docker is not running. All checks run in Docker; start Docker Desktop and retry." >&2
    exit 1
  fi
  echo "pre-commit: running ruff, mypy, pytest in Docker..."
  docker compose --profile dev run --rm -T dev make check-local
fi
