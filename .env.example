# Copy to .env and adjust. Every value has a working default for local Docker use.
# Loaded by pydantic-settings (src/graphrag/config.py); nothing is hard-coded in the code.

# ---------------------------------------------------------------- Neo4j (community)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-local-password

# ---------------------------------------------------------------- Embeddings
# Where embedding compute runs. Query-time embeddings MUST use the same model as the snapshot.
#   fastembed : in-process ONNX model (default; free, offline, data never leaves the container)
#   http      : OpenAI-compatible POST {base_url}/v1/embeddings on another machine (GB10, Ollama,
#               vLLM, text-embeddings-inference, llama.cpp, or this project's own embed server)
#   hash      : deterministic fake, tests only
GRAPHRAG_EMBEDDING_BACKEND=fastembed
GRAPHRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GRAPHRAG_EMBEDDING_DIM=384
GRAPHRAG_EMBEDDING_BATCH_SIZE=64
# fastembed only: use CUDA when the image has fastembed-gpu (e.g. on the GB10)
GRAPHRAG_EMBEDDING_CUDA=false
# http only:
# GRAPHRAG_EMBEDDING_BASE_URL=http://gb10.local:8766/v1
# GRAPHRAG_EMBEDDING_API_KEY=
GRAPHRAG_EMBEDDING_TIMEOUT_SECONDS=120

# Embedding server (docker compose --profile embed up) — run this on the GB10
GRAPHRAG_EMBED_SERVER_HOST=0.0.0.0
GRAPHRAG_EMBED_SERVER_PORT=8766

# ---------------------------------------------------------------- MCP server
GRAPHRAG_MCP_HOST=0.0.0.0
GRAPHRAG_MCP_PORT=8765

# ---------------------------------------------------------------- Paths (inside the container)
GRAPHRAG_PERSONAS_DIR=/app/personas
GRAPHRAG_SNAPSHOTS_DIR=/app/data/snapshots

# ---------------------------------------------------------------- Optional: Claude enrichment
# `graphrag enrich` extracts entities/claims with structured outputs. Needs a key.
# ANTHROPIC_API_KEY=sk-ant-...
GRAPHRAG_ENRICH_MODEL=claude-opus-5
